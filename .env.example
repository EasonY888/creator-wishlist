# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local Postgres runs on 5433, not the default 5432, so it cannot collide with a
# Postgres already installed on the host.
DATABASE_URL=postgresql://wishlist:wishlist@localhost:5433/wishlist

# ---------------------------------------------------------------------------
# Commerce provider (the merchant rail)
# ---------------------------------------------------------------------------

# `live` talks to Agnic over HTTP. `fake` runs the fault-injectable double, which
# is how the failure paths stay demonstrable without an account.
AGNIC_MODE=live

# Server-side only. Never expose this to client code.
AGNIC_TOKEN=

# ---------------------------------------------------------------------------
# Pricing
# ---------------------------------------------------------------------------

# Percent added on top of the merchant's figure. The fan pays merchant + this.
MARKUP_PERCENT=20

# ---------------------------------------------------------------------------
# Fan payments (the fan rail)
# ---------------------------------------------------------------------------

# `fake` uses the in-memory double. `stripe` uses real PaymentIntents.
#
# Test mode is the interesting setting: it moves no money, but every call, error
# code and idempotency semantic is genuine -- which is the entire point, because
# the dangerous states (a hold that is already captured, an amount that no longer
# matches its authorization) do not exist in a double.
PAYMENTS_MODE=fake

# Test keys start with `sk_test_` / `pk_test_`.
#
# The smoke test REFUSES to run against a live key, deliberately: the calls it
# makes include capturing, which would take real money.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the Stripe CLI (`stripe listen`) or the dashboard's webhook settings.
# Required for the webhook route; without it that route returns 500 so Stripe
# keeps retrying rather than dropping events.
STRIPE_WEBHOOK_SECRET=

# The app's own origin, used to build the redirect URL for a payment that needs a
# bank step-up. Only needed for a server-side confirmation.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fan sessions
# ---------------------------------------------------------------------------

# Signs fan session cookies and peppers login-code hashes. At least 16 chars.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing it invalidates every fan session, which is annoying but not dangerous.
# Leaking it lets anyone forge a session -- so it is a real secret, not a build
# constant, and must differ between environments.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Addresses at rest
# ---------------------------------------------------------------------------

# 32 bytes, hex-encoded. Encrypts the shipping address (name, street, locality,
# region, postal code, country, phone) with AES-256-GCM before it reaches the
# database, so a leaked dump is not a leaked address book (NFR-2.2).
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# No default, and no plaintext fallback: without this, reading or writing a
# creator address throws instead of quietly storing one in the clear. That is
# deliberate. A fallback would mean the control is only on in the environments
# where somebody remembered to set the variable -- which is to say, the ones that
# least need it.
ADDRESS_ENCRYPTION_KEY=

# Optional, for rotation. The key above encrypts new writes; this one is also
# tried when reading, so existing rows stay readable while you re-encrypt at your
# own pace. Each ciphertext records the id of the key that opens it, so a row is
# never ambiguous about which secret it needs.
#
# To rotate: move the old value down here, generate a new one above, deploy, run
# `npx tsx scripts/encrypt-existing-addresses.ts` to move old rows onto the new
# key, then clear this variable. Leaving it set is not dangerous, but it does
# keep a retired key live, so it is worth removing once the migration is done.
ADDRESS_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Operator access (/ops)
# ---------------------------------------------------------------------------

# At least 16 characters. A shared password, exchanged for a signed httpOnly
# cookie; the sign-in form is at /ops/login.
#
# **Unset means /ops is CLOSED, not open.** That is the important half: an access
# control whose absence means "allow everyone" looks like a control and behaves
# like a doorman who went home.
#
# This is a shared secret, so it proves *that* someone is an operator and never
# *which* operator. Attributing a refund or a resolution to a person still needs
# real accounts, which is why the actor recorded on those actions is a constant.
OPS_PASSWORD=

# ---------------------------------------------------------------------------
# Email (fan login codes)
# ---------------------------------------------------------------------------

# With both of these set, the fan's six-digit code is emailed. With either
# missing, the code is PRINTED TO THE SERVER LOG -- which is what makes the login
# flow finishable in development without a mailbox.
#
# The fallback is refused outright when NODE_ENV=production, because a valid
# login code in a log file is an account for anyone who can read the log.
#
# Resend is used because it is one authenticated POST; swapping providers means
# editing one `fetch` in src/fans/email.ts.
RESEND_API_KEY=
EMAIL_FROM=
